#!/bin/sh
# git credential helper: the token for the owner in the repository URL.
#
# Configured by the entrypoint for https://github.com with useHttpPath, so
# git hands over "path=<owner>/<repo>.git" and every push, fetch or clone
# gets the token of that owner (see gh-token). Nothing is stored or erased:
# the tokens come from the environment only.

[ "$1" = "get" ] || exit 0

path=""
while IFS= read -r line; do
    case "$line" in
        path=*) path=${line#path=} ;;
    esac
done

owner=${path%%/*}
token=$(gh-token "$owner")
[ -n "$token" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$token"
