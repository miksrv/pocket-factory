# ---- Telegram -------------------------------------------------------------
# Token from @BotFather. Leave empty to run the factory web-only.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id(s), comma separated. Everyone else is ignored.
# Find yours via @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=

# ---- Workspaces -----------------------------------------------------------
# Host directory that holds your git repositories. Mounted read-write into the
# container as /data/workspaces. Leave unset on a VPS to use ./data/workspaces.
WORKSPACES_DIR=/Users/you/Developer/projects

# ---- GitHub ---------------------------------------------------------------
# Fine-grained PAT scoped to the repositories the factory may touch.
# Used by `gh` and, through the image's git credential helper, by `git push` over HTTPS.
GH_TOKEN=
# A fine-grained PAT has one resource owner, so your own repositories and an
# organization's need a token each: GH_TOKEN_<OWNER>, the login upper-cased with
# "-" as "_" (my-org → GH_TOKEN_MY_ORG). git and gh pick the token from the
# repository's owner; GH_TOKEN is the fallback for owners without one.
# GH_TOKEN_MYLOGIN=
# GH_TOKEN_MY_ORG=
GIT_AUTHOR_NAME=Pocket Factory
GIT_AUTHOR_EMAIL=you@example.com

# ---- Claude Code ----------------------------------------------------------
# Leave this EMPTY and log the container into your Claude account once instead:
#   docker compose run --rm -it supervisor claude auth login
# prints a URL; open it on any machine with a browser, paste the code back. The
# login lands in data/claude/.credentials.json, the CLI refreshes it by itself,
# and the connectors of your claude.ai account (Gmail, ClickUp, …) become
# available to the agents. Same over `ssh -t` on a VPS.
# Fallback only: a `claude setup-token` value here makes the CLI use that token
# instead — model calls work, connectors do not.
CLAUDE_CODE_OAUTH_TOKEN=
# Model for factory sessions. Leave empty to use the CLI default (which may be
# the most expensive model). Examples: sonnet, opus, claude-sonnet-5
CLAUDE_MODEL=sonnet
# Hard limits per session, enforced by the CLI itself.
CLAUDE_MAX_TURNS=50
CLAUDE_MAX_BUDGET_USD=5
# Wall-clock limit per task in minutes; 0 = none. A tool that never returns
# (a dev server started in the foreground) otherwise holds a session slot forever.
CLAUDE_TASK_TIMEOUT_MIN=0
# Permission mode. docker-compose.yml overrides this to bypassPermissions
# (the container is the sandbox). When running the supervisor directly on
# your machine with `yarn dev`, keep acceptEdits.
CLAUDE_PERMISSION_MODE=acceptEdits

# ---- Voice (optional) -----------------------------------------------------
# Telegram voice notes are transcribed with Whisper on Groq. Leave empty to
# disable voice input. https://console.groq.com/keys
GROQ_API_KEY=
STT_MODEL=whisper-large-v3-turbo
# ISO-639-1 language hint (e.g. en, ru). Empty = autodetect.
STT_LANGUAGE=

# ---- Web UI ---------------------------------------------------------------
# The UI controls an agent with repository and host access. Set a password
# (basic auth) and keep the port on localhost / behind Tailscale or a proxy.
WEB_PORT=8080
# Interface docker publishes the port on. Keep 127.0.0.1 unless a password is set.
WEB_BIND=127.0.0.1
WEB_AUTH_USER=factory
WEB_AUTH_PASSWORD=
# Without a password the API answers only to localhost names, so a page on
# another site cannot reach it through DNS rebinding. Add the names you open
# the UI with over a LAN or Tailscale, comma separated (e.g. factory.tail1234.ts.net).
WEB_ALLOWED_HOSTS=

# ---- Supervisor -----------------------------------------------------------
# How many claude -p processes may run at once (≈1 GiB RAM each).
MAX_CONCURRENT_SESSIONS=2
# Memory ceiling of the container (docker compose mem_limit): sessions plus the projects' own tooling.
CONTAINER_MEMORY=6g
LOG_LEVEL=info
